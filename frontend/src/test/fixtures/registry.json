    "statements": {
      "part_time": {
        "id": "part_time",
        "text": "The requirement applies to the monthly salary actually paid. Migrationsverket states it as \"a monthly salary or wages totalling at least\" the threshold and gives no reduction for part-time work, so a part-time salary must still reach the full amount.",
        "source": {
