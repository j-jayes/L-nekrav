data: {"result": {"task": {"id": "52d69030-93dc-471f-b388-27bc617a8bf0", "contextId": "b7d156e4-bf24-4450-bad1-2fe7f2c38611", "status": {"state": "TASK_STATE_SUBMITTED"}, "history": [{"messageId": "web-1", "contextId": "b7d156e4-bf24-4450-bad1-2fe7f2c38611", "taskId": "52d69030-93dc-471f-b388-27bc617a8bf0", "role": "ROLE_USER", "parts": [{"data": {"ad": "Backend Developer (Python)\n\nAbout us\nNorthwind Ledger is a fast-growing fintech company in Stockholm. We help 4 000 small businesses get paid on time. Our team of 60 people comes from 20 countries.\n\nResponsibilities\n- Design, build and maintain the REST APIs behind our invoicing platform\n- Write well-tested Python services and review your colleagues' code\n- Improve the performance and reliability of our PostgreSQL databases\n- Take part in the on-call rotation and fix production incidents\n\nRequirements\n- At least three years of experience developing backend systems in Python\n- Good knowledge of SQL and relational databases\n- Experience with Docker and cloud platforms such as AWS\n- Fluent English; Swedish is a plus\n\nWhat we offer\n- Hybrid work with three office days a week\n- Six weeks of vacation and a wellness allowance of 5 000 SEK\n- Occupational pension and private health insurance\n", "background": "MSc in computer science; five years as a Python backend developer", "offer": {"application_type": "first_permit", "filed_on": "2026-10-01", "fte_percent": 100.0, "monthly_salary_sek": 52000.0}}}]}]}}, "id": 1, "jsonrpc": "2.0"}

