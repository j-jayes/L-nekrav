data: {"result": {"task": {"id": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "status": {"state": "TASK_STATE_SUBMITTED"}, "history": [{"messageId": "web-1", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "role": "ROLE_USER", "parts": [{"data": {"background": "MSc in computer science; five years as a Python backend developer", "offer": {"fte_percent": 100.0, "filed_on": "2026-10-01", "application_type": "first_permit", "monthly_salary_sek": 52000.0}, "ad": "Backend Developer (Python)\n\nAbout us\nNorthwind Ledger is a fast-growing fintech company in Stockholm. We help 4 000 small businesses get paid on time. Our team of 60 people comes from 20 countries.\n\nResponsibilities\n- Design, build and maintain the REST APIs behind our invoicing platform\n- Write well-tested Python services and review your colleagues' code\n- Improve the performance and reliability of our PostgreSQL databases\n- Take part in the on-call rotation and fix production incidents\n\nRequirements\n- At least three years of experience developing backend systems in Python\n- Good knowledge of SQL and relational databases\n- Experience with Docker and cloud platforms such as AWS\n- Fluent English; Swedish is a plus\n\nWhat we offer\n- Hybrid work with three office days a week\n- Six weeks of vacation and a wellness allowance of 5 000 SEK\n- Occupational pension and private health insurance\n"}}]}]}}, "id": 1, "jsonrpc": "2.0"}

data: {"result": {"statusUpdate": {"taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "status": {"state": "TASK_STATE_WORKING", "message": {"messageId": "a4cf5fcc-9117-4ec3-9758-72ec608743fa", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "role": "ROLE_AGENT", "parts": [{"text": "Reading the job ad"}]}, "timestamp": "2026-10-22T12:56:47.329541Z"}}}, "id": 1, "jsonrpc": "2.0"}

data: {"result": {"statusUpdate": {"taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "status": {"state": "TASK_STATE_WORKING", "message": {"messageId": "14cda7bf-be75-4138-836b-8397b25dbe22", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "role": "ROLE_AGENT", "parts": [{"text": "Calling search_occupations"}]}, "timestamp": "2026-10-22T12:56:51.000447Z"}}}, "id": 1, "jsonrpc": "2.0"}

data: {"result": {"artifactUpdate": {"taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "artifact": {"artifactId": "b233ccda-ce7e-4a8c-8874-ac59996210b2", "name": "ui_sync:search_occupations", "parts": [{"data": {"result": {"title_list": null, "low_confidence": false, "hits": [{"code": "2512", "fused_score": 0.037625594923320994, "title_sv": "Mjukvaru- och systemutvecklare m.fl.", "legal_flags": [], "matched_chunk": {"kind": "synonyms_en", "text": "database designers; data base designers; database architect; data base designer; database design engineer; data model designer; software developer; application programmer; solutions developer; programmer; software specialist; application software developer; software developers; software engineer; applications engineer; soft developer; developer of software; database integrator; data base integrators; data base integrator; database integrators; data integrator; database development specialist; data warehouse designer; data warehouse architect; data warehouse developer; ICT system architect; ICT systems architect; solution architect; IT systems architect; IT system architect; systems architect; ICT system architects; ICT systems architects; information systems architect; mobile application developer; app developer; mobile app specialist; mobile app developer; mobile application developers"}, "ranks": {"bm25": 2.0, "harrier": 1.0, "kblab": 1.0}, "title_en": "Software- and system developers", "scores": {"bm25": 78.05026245117188, "harrier": 0.5412302017211914, "kblab": 0.5985780954360962}, "fused_rank": 1.0}, {"code": "3513", "fused_score": 0.03701996927803379, "title_sv": "Systemadministratörer", "legal_flags": [{"note": "5 kap. 6 §: the 90 % requirement does not apply; 75 % of the median applies instead.", "source": {"url": "https://svenskforfattningssamling.se/doc/2026605.html", "source": "sfs", "ref": "SFS 2026:605, 5 kap. 6 §"}, "checked_on": "2026-10-20", "effective_from": "2026-06-01", "kind": "exempt_75"}], "matched_chunk": {"kind": "desc_en", "text": "(a)  designing and developing database architecture, data structures, tables, dictionaries and naming conventions for information systems projects; (b)  designing, constructing, modifying, integrating, implementing and testing database management systems; (c)  conducting research and providing advice on the selection, application and implementation of database management tools; (d)  developing and implementing data administration policy, documentation, standards and models; (e)  developing policies and procedures for database access and usage and for the backup and recovery of data; (f)  performing the operational establishment and preventive maintenance of backups, recovery procedures, and enforcing security and integrity controls."}, "ranks": {"bm25": 3.0, "harrier": 2.0, "kblab": 2.0}, "title_en": "System administrators", "scores": {"bm25": 63.039833068847656, "harrier": 0.5401063561439514, "kblab": 0.5628695487976074}, "fused_rank": 2.0}, {"code": "2519", "fused_score": 0.03524891513982642, "title_sv": "Övriga IT-specialister", "legal_flags": [], "matched_chunk": {"kind": "desc_en", "text": "User experience analysts assess client interaction and experience and analyse users' behaviours, attitudes, and emotions about the usage of a particular product, system or service. They make proposals for the improvement of the interface and usability of products, systems or services. In doing so, they take into consideration the practical, experiential, affective, meaningful and valuable aspects of human–computer interaction and product ownership, as well as the person's perceptions of system aspects such as utility, ease of use and efficiency, and user experience dynamics."}, "ranks": {"bm25": 1.0, "harrier": 8.0, "kblab": 4.0}, "title_en": "ICT-specialist professionals not elsewhere classified", "scores": {"bm25": 79.68771362304688, "harrier": 0.4972383379936218, "kblab": 0.5557272434234619}, "fused_rank": 3.0}, {"code": "2511", "fused_score": 0.03418287502794545, "title_sv": "Systemanalytiker och IT-arkitekter m.fl.", "legal_flags": [], "matched_chunk": {"kind": "desc_sv", "text": "Systemintegrationskonsulter ger råd om sammanförande av olika system till interoperation inom en organisation för att möjliggöra datadelning och minska redundans."}, "ranks": {"bm25": 11.0, "harrier": 11.0, "kblab": 3.0}, "title_en": "System analysts and ICT-architects", "scores": {"bm25": 55.283973693847656, "harrier": 0.4898415207862854, "kblab": 0.5600056648254395}, "fused_rank": 4.0}, {"code": "4119", "fused_score": 0.033138112775639425, "title_sv": "Övriga kontorsassistenter och sekreterare", "legal_flags": [], "matched_chunk": {"kind": "desc_en", "text": "(a)  receiving and registering invoices, forms, records and other documents for data capture; (b)  entering numerical data, codes and text from source material into computer-compatible storage and processing devices; (c)  verifying accuracy and completeness of data and correcting entered data, if needed; (d)  operating bookkeeping and calculating machines; (e)  importing and exporting data between different database systems and software."}, "ranks": {"bm25": 38.0, "harrier": 7.0, "kblab": 6.0}, "title_en": "Office clerks not elsewhere classified", "scores": {"bm25": 50.8255729675293, "harrier": 0.49979549646377563, "kblab": 0.5359843373298645}, "fused_rank": 5.0}], "fallback_reason": null, "passages": [{"label": "title", "by": "position", "index": 0.0, "keep": true, "text": "Backend Developer (Python)"}, {"label": "company", "by": "heading", "index": 1.0, "keep": false, "text": "Northwind Ledger is a fast-growing fintech company in Stockholm."}, {"label": "company", "by": "heading", "index": 2.0, "keep": false, "text": "We help 4 000 small businesses get paid on time."}, {"label": "company", "by": "heading", "index": 3.0, "keep": false, "text": "Our team of 60 people comes from 20 countries."}, {"label": "duty", "by": "heading", "index": 4.0, "keep": true, "text": "Design, build and maintain the REST APIs behind our invoicing platform"}, {"label": "duty", "by": "heading", "index": 5.0, "keep": true, "text": "Write well-tested Python services and review your colleagues' code"}, {"label": "duty", "by": "heading", "index": 6.0, "keep": true, "text": "Improve the performance and reliability of our PostgreSQL databases"}, {"label": "duty", "by": "heading", "index": 7.0, "keep": true, "text": "Take part in the on-call rotation and fix production incidents"}, {"label": "skill", "by": "heading", "index": 8.0, "keep": true, "text": "At least three years of experience developing backend systems in Python"}, {"label": "skill", "by": "heading", "index": 9.0, "keep": true, "text": "Good knowledge of SQL and relational databases"}, {"label": "skill", "by": "heading", "index": 10.0, "keep": true, "text": "Experience with Docker and cloud platforms such as AWS"}, {"label": "skill", "by": "heading", "index": 11.0, "keep": true, "text": "Fluent English; Swedish is a plus"}, {"label": "benefits", "by": "heading", "index": 12.0, "keep": false, "text": "Hybrid work with three office days a week"}, {"label": "benefits", "by": "heading", "index": 13.0, "keep": false, "text": "Six weeks of vacation and a wellness allowance of 5 000 SEK"}, {"label": "benefits", "by": "heading", "index": 14.0, "keep": false, "text": "Occupational pension and private health insurance"}], "mode_used": "full", "searched_text": "Backend Developer (Python)\nDesign, build and maintain the REST APIs behind our invoicing platform\nWrite well-tested Python services and review your colleagues' code\nImprove the performance and reliability of our PostgreSQL databases\nTake part in the on-call rotation and fix production incidents\nAt least three years of experience developing backend systems in Python\nGood knowledge of SQL and relational databases\nExperience with Docker and cloud platforms such as AWS\nFluent English; Swedish is a plus", "honest_fit": "The SSYK code on a work-permit offer must match the duties actually performed. These are the occupations whose official descriptions best match the text, not advice on which code to choose."}, "tool": "search_occupations", "kind": "ui_sync", "args": {"request": {"mode": "full", "k": 5.0, "parse_ad": true, "text": "Backend Developer (Python)\n\nAbout us\nNorthwind Ledger is a fast-growing fintech company in Stockholm. We help 4 000 small businesses get paid on time. Our team of 60 people comes from 20 countries.\n\nResponsibilities\n- Design, build and maintain the REST APIs behind our invoicing platform\n- Write well-tested Python services and review your colleagues' code\n- Improve the performance and reliability of our PostgreSQL databases\n- Take part in the on-call rotation and fix production incidents\n\nRequirements\n- At least three years of experience developing backend systems in Python\n- Good knowledge of SQL and relational databases\n- Experience with Docker and cloud platforms such as AWS\n- Fluent English; Swedish is a plus\n\nWhat we offer\n- Hybrid work with three office days a week\n- Six weeks of vacation and a wellness allowance of 5 000 SEK\n- Occupational pension and private health insurance"}}}}]}}}, "id": 1, "jsonrpc": "2.0"}

data: {"result": {"statusUpdate": {"taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "status": {"state": "TASK_STATE_WORKING", "message": {"messageId": "101a300f-ca6b-4791-aca9-046e3a69985d", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "role": "ROLE_AGENT", "parts": [{"text": "Calling compare_occupations"}]}, "timestamp": "2026-10-22T12:56:55.291035Z"}}}, "id": 1, "jsonrpc": "2.0"}

data: {"result": {"artifactUpdate": {"taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "artifact": {"artifactId": "e73d1b46-60f9-4d93-851a-5d3bc5f4e7a0", "name": "ui_sync:compare_occupations", "parts": [{"data": {"result": {"columns": [{"code": "2512", "eligibility": {"rule_id": "salary_90", "median": {"effective_to": null, "scb_reference_year": 2025.0, "source": {"url": "https://www.migrationsverket.se/ordforklaringar/lonekrav-for-arbetstillstand", "checked_on": "2026-10-21", "title": "Migrationsverket: Lönekrav för arbetstillstånd", "key": "mv_lonekrav"}, "effective_from": "2026-06-16", "amount": 38300.0}, "percent": 90.0, "warnings": [], "disclaimer": "The salary must also be in line with the collective agreement or what is customary in the occupation or industry, which Lönekrav does not check. This is information, not legal advice.", "margin_sek": 17530.0, "status": "pass", "sources": [{"url": "https://www.migrationsverket.se/ordforklaringar/lonekrav-for-arbetstillstand", "checked_on": "2026-10-21", "title": "Migrationsverket: Lönekrav för arbetstillstånd", "key": "mv_lonekrav"}], "margin_percent": 50.9, "reason": "Salary requirement for first permits decided from 1 June 2026 and for extensions not covered by the transition: at least 90 % of the median in force when the application was filed.", "threshold_sek": 34470.0}, "title_sv": "Mjukvaru- och systemutvecklare m.fl.", "legal_flags": [], "latest": {"p10_ci95": 1080.0, "suppressed": [], "median": 53500.0, "median_ci95": 880.0, "year": 2025.0, "p90_ci95": 1340.0, "reference_year": 2025.0, "p25_ci95": 970.0, "mean_ci95": 940.0, "p75_ci95": 1160.0, "source_table": "TAB5932", "p90": 72600.0, "fetched_at": "2026-10-20T20:54:49.024907Z", "p75": 62600.0, "p25": 46200.0, "mean": 55500.0, "p10": 39600.0, "code": "2512"}, "title_en": "Software- and system developers", "threshold": {"on": "2026-10-01", "rule_id": "salary_90", "percent": 90.0, "median_reference_year": 2025.0, "amount_sek": 34470.0, "median_sek": 38300.0}, "tasks_en": [{"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/866c7813-2c03-47d7-9bdc-192cfbace57c", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/866c7813-2c03-47d7-9bdc-192cfbace57c"}, "shared_with": [], "text": "User interface developers implement, code, document and maintain the interface of a software system by using front-end development technologies.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/bd272aee-adc9-4a06-a15c-a73b4b4a46a7", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/bd272aee-adc9-4a06-a15c-a73b4b4a46a7"}, "shared_with": [], "text": "ICT application developers implement the ICT (software) applications based on the designs provided using application domain specific languages, tools, platforms and experience.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/8b6388a4-4904-471b-9331-d3b1211f5525", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/8b6388a4-4904-471b-9331-d3b1211f5525"}, "shared_with": [], "text": "ICT project managers schedule, control and direct the resources, people, funding and facilities to achieve the objectives of ICT projects. They establish budgets and timelines, perform risk analysis and quality management, and complete project closure reports.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/a7c1d23d-aeca-4bee-9a08-5993ed98b135", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/a7c1d23d-aeca-4bee-9a08-5993ed98b135"}, "shared_with": [], "text": "ICT system developers maintain, audit and improve organisational support systems. They use existing or new technologies to meet particular needs. They test both hardware and software system components, diagnose and resolve system faults.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/b11e1742-5e28-4270-b081-b0193d85ee7d", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/b11e1742-5e28-4270-b081-b0193d85ee7d"}, "shared_with": [], "text": "Database developers program, implement and coordinate changes to computer databases based on their expertise of database management systems.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/8d9ec84d-cf2d-4179-87bc-335cda54a427", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/8d9ec84d-cf2d-4179-87bc-335cda54a427"}, "shared_with": [], "text": "Database designers specify the database's logical structure, processes, and information flows. They design data models and databases to serve data acquisition.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/f2b15a0e-e65a-438a-affb-29b9d50b77d1", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/f2b15a0e-e65a-438a-affb-29b9d50b77d1"}, "shared_with": [], "text": "Software developers implement or program all kinds of software systems based on specifications and designs by using programming languages, tools, and platforms.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/3d190639-90f8-4402-b1b3-a104a17e0d67", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/3d190639-90f8-4402-b1b3-a104a17e0d67"}, "shared_with": [], "text": "Database integrators perform integration among different databases. They maintain integration and ensure interoperability.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/1562c7a3-c7d9-419d-b9b6-db26610bcf84", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/1562c7a3-c7d9-419d-b9b6-db26610bcf84"}, "shared_with": [], "text": "Data warehouse designers are responsible for planning, connecting, designing, scheduling, and deploying data warehouse systems. They develop, monitor and maintain ETL processes, reporting applications and data warehouse design.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/e1c72b5f-4c5c-487c-a6df-e84b64a51dae", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/e1c72b5f-4c5c-487c-a6df-e84b64a51dae"}, "shared_with": [], "text": "ICT system architects design architecture, components, modules, interfaces, and data for a multi-components system to meet specified requirements.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/2ed56c3f-61d6-4f7e-9ef8-8849eb102e4c", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/2ed56c3f-61d6-4f7e-9ef8-8849eb102e4c"}, "shared_with": [], "text": "Mobile app developers implement applications software for mobile devices, based on the designs provided, using general or specific development tools for device operating systems.", "kind": "definition"}], "tasks_sv": [{"lang": "sv", "isco_code": null, "source": {"url": "https://taxonomy.api.jobtechdev.se/v1/taxonomy/graphql", "source": "jobtech", "ref": "taxonomy ssyk-level-4"}, "shared_with": [], "text": "Analyserar, designar och utvecklar IT-system eller delar av system. Utformar och utvecklar lösningar för programvara, applikationer, system och databaser.", "kind": "definition"}]}, {"code": "2511", "eligibility": {"rule_id": "salary_90", "median": {"effective_to": null, "scb_reference_year": 2025.0, "source": {"url": "https://www.migrationsverket.se/ordforklaringar/lonekrav-for-arbetstillstand", "checked_on": "2026-10-21", "title": "Migrationsverket: Lönekrav för arbetstillstånd", "key": "mv_lonekrav"}, "effective_from": "2026-06-16", "amount": 38300.0}, "percent": 90.0, "warnings": [], "disclaimer": "The salary must also be in line with the collective agreement or what is customary in the occupation or industry, which Lönekrav does not check. This is information, not legal advice.", "margin_sek": 17530.0, "status": "pass", "sources": [{"url": "https://www.migrationsverket.se/ordforklaringar/lonekrav-for-arbetstillstand", "checked_on": "2026-10-21", "title": "Migrationsverket: Lönekrav för arbetstillstånd", "key": "mv_lonekrav"}], "margin_percent": 50.9, "reason": "Salary requirement for first permits decided from 1 June 2026 and for extensions not covered by the transition: at least 90 % of the median in force when the application was filed.", "threshold_sek": 34470.0}, "title_sv": "Systemanalytiker och IT-arkitekter m.fl.", "legal_flags": [], "latest": {"p10_ci95": 490.0, "suppressed": [], "median": 56200.0, "median_ci95": 790.0, "year": 2025.0, "p90_ci95": 1480.0, "reference_year": 2025.0, "p25_ci95": 1020.0, "mean_ci95": 590.0, "p75_ci95": 1240.0, "source_table": "TAB5932", "p90": 77800.0, "fetched_at": "2026-10-20T20:54:49.024907Z", "p75": 66700.0, "p25": 47700.0, "mean": 58500.0, "p10": 41000.0, "code": "2511"}, "title_en": "System analysts and ICT-architects", "threshold": {"on": "2026-10-01", "rule_id": "salary_90", "percent": 90.0, "median_reference_year": 2025.0, "amount_sek": 34470.0, "median_sek": 38300.0}, "tasks_en": [{"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/a6a0b60f-08da-4faa-bf54-942987efb471", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/a6a0b60f-08da-4faa-bf54-942987efb471"}, "shared_with": [], "text": "ICT system analysts specify the system needs to meet the end user requirements. They analyse system functions in order to define their goals or purposes and to discover operations and procedures for accomplishing them most efficiently. They also design new IT solutions to improve business efficiency and productivity, produce outline designs and estimate costs of new systems, specify the operations the system will perform, and the way data will be viewed by the end user. They present the design to the users and work closely with the users to implement the solution.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/fe0fa514-b48d-4a53-9757-a283c0baacf0", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/fe0fa514-b48d-4a53-9757-a283c0baacf0"}, "shared_with": [], "text": "ICT business analysts are in charge of analysing and designing an organisation's processes and systems, assessing the business model and its integration with technology. They also identify change needs, assess the impact of the change, capture and document requirements and then ensure that these requirements are delivered whilst supporting the business through the implementation process.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/cdd3d773-75a4-4f35-bd1d-1ac720afcf9d", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/cdd3d773-75a4-4f35-bd1d-1ac720afcf9d"}, "shared_with": [], "text": "IT auditors perform audits of information systems, platforms, and operating procedures in accordance with established corporate standards for efficiency, accuracy and security. They evaluate ICT infrastructure in terms of risk to the organisation and establish controls to mitigate loss. They determine and recommend improvements in the current risk management controls and in the implementation of system changes or upgrades.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/e0b544dd-b621-4126-a55e-054af25c6ea0", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/e0b544dd-b621-4126-a55e-054af25c6ea0"}, "shared_with": [], "text": "ICT network architects design the topology and connectivity of ICT network such as hardware, infrastructure, communication and hardware components.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/258e46f9-0075-4a2e-adae-1ff0477e0f30", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/258e46f9-0075-4a2e-adae-1ff0477e0f30"}, "shared_with": [], "text": "Data scientists find and interpret rich data sources, manage large amounts of data, merge data sources, ensure consistency of data-sets, and create visualisations to aid in understanding data. They build mathematical models using data, present and communicate data insights and findings to specialists and scientists in their team and if required, to a non-expert audience, and recommend ways to apply the data.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/456ed487-02f2-45c9-9213-d0fd8e9a069d", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/456ed487-02f2-45c9-9213-d0fd8e9a069d"}, "shared_with": [], "text": "ICT application configurators identify, record, and maintain user-specific application configurations based upon user requirements and business rules. They configure generic software systems in order to create a specific version applied to an organisation's context. These configurations range from adjusting basic parameters through the creation of business rules and roles in the ICT system to developing specific modules (including the configuration of Commercial off-the-shelf systems (COTS)). They also document configurations, perform configuration updates, and ensure the configurations are correctly implemented in the application.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/98c3d8f8-e3a8-49b7-9e58-236f25a6f6a0", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/98c3d8f8-e3a8-49b7-9e58-236f25a6f6a0"}, "shared_with": [], "text": "System configurators tailor a computer system to the organisation's and users' needs. They adjust the base system and software to the needs of the customer. They perform configuration activities and scripting and ensure communication with users.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/4543bf7b-8ffb-4ade-88b9-58da34366f04", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/4543bf7b-8ffb-4ade-88b9-58da34366f04"}, "shared_with": [], "text": "ICT capacity planners ensure that the capacity of ICT services and ICT infrastructure is able to deliver agreed service level targets in a cost effective and timely manner. They also consider all resources required to deliver the appropriate ICT service, and plan for short, medium, and long term business requirements.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/04ba4d6c-957d-417f-bf63-5b9e015a9f86", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/04ba4d6c-957d-417f-bf63-5b9e015a9f86"}, "shared_with": [], "text": "Software analysts elicit and prioritise user requirements, produce and document software specifications, test their application, and review them during software development. They act as the interface between the software users and the software development team.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/2bef94db-0088-4507-982a-2ca717529adb", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/2bef94db-0088-4507-982a-2ca717529adb"}, "shared_with": [], "text": "Enterprise architects balance technological opportunities with business requirements. They also maintain a holistic view of the organisation's strategy, processes, information and ICT assets and link the business mission, strategy and processes to the ICT strategy.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/bd9d395a-d587-45c6-8d72-ceef226df9e1", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/bd9d395a-d587-45c6-8d72-ceef226df9e1"}, "shared_with": [], "text": "ICT system integration consultants advise on bringing together different systems to interoperate within an organisation for enabling data sharing and reducing redundancy.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/07e60525-1aad-4099-aaf3-2c7014c92212", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/07e60525-1aad-4099-aaf3-2c7014c92212"}, "shared_with": [], "text": "Integration engineers develop and implement solutions which coordinate applications across the enterprise or its units and departments. They evaluate existing components or systems to determine integration requirements and ensure that the final solutions meet organisational needs. They reuse components when possible and assist management in taking decisions. They perform ICT system integration troubleshooting.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/d0aa0792-4345-474b-9365-686cf4869d2e", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/d0aa0792-4345-474b-9365-686cf4869d2e"}, "shared_with": [], "text": "Software architects create the technical design and the functional model of a software system, based on functional specifications. They also design the architecture of the system or different modules and components related to the business' or customer requirements, technical platform, computer language or development environment.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/3765a20d-5160-4e8f-82f1-ad7872b9db24", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/3765a20d-5160-4e8f-82f1-ad7872b9db24"}, "shared_with": [], "text": "Information managers are responsible for systems that provide information to people. They assure access to the information in different work environments (public or private) based on theoretical principles and hands-on capabilities in storing, retrieving and communicating information.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/b1c80369-067e-4041-84c8-dbe65640a5d8", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/b1c80369-067e-4041-84c8-dbe65640a5d8"}, "shared_with": [], "text": "ICT consultants provide advice on how to optimise the use of existing tools and systems, make recommendations for the development and implementation of a business project or technological solution and contribute to project definitions. They raise awareness on information technology innovations and their potential value to a business. They also participate in the assessment and choice of ICT solutions.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/4b3201cb-ffc5-4f61-9fc3-5c0f0038fa5f", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/4b3201cb-ffc5-4f61-9fc3-5c0f0038fa5f"}, "shared_with": [], "text": "ICT business analysis managers identify areas where information system changes are needed to support business plans and monitor the impact in terms of change management. They contribute to the general ICT functional requirements of the business organisation. ICT business analysis managers analyse business needs and translate them into ICT solutions.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/22987b58-dbfa-4ecd-ae3f-82dd209255f6", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/22987b58-dbfa-4ecd-ae3f-82dd209255f6"}, "shared_with": [], "text": "Green ICT consultants advise organisations on their green ICT strategy and its implementation in the most effective and efficient manner to allow the organisation to reach their short, mid, and long term ICT environmental objectives.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/6e92d4b5-3167-4166-802f-da7753951a31", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/6e92d4b5-3167-4166-802f-da7753951a31"}, "shared_with": [], "text": "ICT research consultants perform targeted ICT research and provide a final report to the client. They also use ICT tools to design questionnaires for surveys, analyse the results, write reports, present the results and make recommendations based on the research findings.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/e1c72b5f-4c5c-487c-a6df-e84b64a51dae", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/e1c72b5f-4c5c-487c-a6df-e84b64a51dae"}, "shared_with": [], "text": "ICT system architects design architecture, components, modules, interfaces, and data for a multi-components system to meet specified requirements.", "kind": "definition"}, {"lang": "en", "isco_code": null, "source": {"url": "http://data.europa.eu/esco/occupation/10469d70-78a3-4650-9e29-d04de13c62c1", "source": "esco", "ref": "http://data.europa.eu/esco/occupation/10469d70-78a3-4650-9e29-d04de13c62c1"}, "shared_with": [], "text": "Embedded system designers translate and design requirements and the high-level plan or architecture of an embedded control system according to technical software specifications.", "kind": "definition"}], "tasks_sv": [{"lang": "sv", "isco_code": null, "source": {"url": "https://taxonomy.api.jobtechdev.se/v1/taxonomy/graphql", "source": "jobtech", "ref": "taxonomy ssyk-level-4"}, "shared_with": [], "text": "Tar fram strategier för utveckling av IT-system. Ansvarar för företags och organisationers IT-struktur och ser till att IT används på ett effektivt sätt. Ansvarar för att den tekniska arkitekturen understödjer verksamhetens behov och krav.", "kind": "definition"}]}], "honest_fit": "The SSYK code on a work-permit offer must match the duties actually performed. These are the occupations whose official descriptions best match the text, not advice on which code to choose."}, "tool": "compare_occupations", "kind": "ui_sync", "args": {"request": {"offer": {"exemptions": [], "decided_on": "2026-10-22", "fte_percent": 100.0, "filed_on": "2026-10-01", "application_type": "first_permit", "monthly_salary_sek": 52000.0}, "codes": ["2512", "2511"]}}}}]}}}, "id": 1, "jsonrpc": "2.0"}

data: {"result": {"artifactUpdate": {"taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "artifact": {"artifactId": "ba72b409-74b1-428b-ba23-eeb36a04b523", "name": "memo", "parts": [{"text": "# Work-permit occupation memo: Backend Developer (Python)\n\n*Information, not legal advice.*\n\n## Plausible codes\n\n**2512 Mjukvaru- och systemutvecklare m.fl. (Software- and system developers): best fit**\n- The ad's core duties are building and maintaining REST APIs, writing Python services, improving PostgreSQL databases, and fixing production incidents. These are software development and maintenance duties, which this code covers.\n- **Threshold:** 34,470 SEK per month. This is 90 % of the 38,300 SEK median, under the rule for first permits filed from 1 June 2026.\n- **Offer result: pass.** The offer of 52,000 SEK per month at 100 % full time clears the threshold by 17,530 SEK (50.9 %). There are no warnings.\n- **Context:** SCB's 2025 figures for this code show a median of 53,500 SEK per month (p25 46,200, p75 62,600). The offer is close to that median.\n\n**2511 Systemanalytiker och IT-arkitekter m.fl. (System analysts and ICT-architects): weaker fit**\n- This code centres on analysing business needs, setting IT strategy and designing system architecture. The ad describes hands-on implementation and maintenance, not an analysis or architecture role, so the duties do not match well.\n- **Threshold:** the same 34,470 SEK, and the offer also passes with a 17,530 SEK margin.\n- I include it only for comparison. Choose it only if the job actually involves the analysis or architecture duties described for 2511.\n\n## Notes\n- **Duties decide the code.** The code on the permit application must match the duties the person will actually perform. The threshold is not a reason to pick a code, and I have not ranked the codes by threshold.\n- **Collective agreement and customary pay:** Lönekrav checks only the statutory threshold. The salary must also match the collective agreement or what is customary in the occupation or industry, and Lönekrav does not check this.\n\n## Sources (checked dates from tool results)\n- Migrationsverket, *Lönekrav för arbetstillstånd* (https://www.migrationsverket.se/ordforklaringar/lonekrav-for-arbetstillstand), checked 2026-10-21. Median of 38,300 SEK, effective from 2026-06-16, SCB reference year 2025.\n- SFS 2026:605, 5 kap. 6 §, which the tool flagged for code 2511 (the search flag for 3513, not a code considered here). Not applicable to these codes. Source: https://svenskforfattningssamling.se/doc/2026605.html, checked 2026-10-20.\n- SCB salary statistics, table TAB5932, reference year 2025, fetched 2026-10-20.\n\nThe SSYK code on a work-permit offer must match the duties actually performed. These are the occupations whose official descriptions best match the text, not advice on which code to choose.\n\nWritten with a third-party language model (via OpenRouter), which received the ad, background and offer you sent.", "mediaType": "text/markdown"}]}, "lastChunk": true}}, "id": 1, "jsonrpc": "2.0"}

data: {"result": {"statusUpdate": {"taskId": "a37cc001-e062-4fad-87c6-a9deab55a382", "contextId": "50d6e59d-cb13-4cc3-87c7-cef7d7e24f0b", "status": {"state": "TASK_STATE_COMPLETED", "timestamp": "2026-10-22T12:57:02.292996Z"}}}, "id": 1, "jsonrpc": "2.0"}

